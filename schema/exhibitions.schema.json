{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exhibitions",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "venueId", "title", "startDate", "endDate", "type", "photographerIds"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "venueId": { "type": "string", "minLength": 1 },
      "festivalId": { "type": ["string", "null"], "minLength": 1 },
      "title": { "type": "string", "minLength": 1 },
      "startDate": { "type": "string", "format": "date" },
      "endDate": { "type": "string", "format": "date" },
      "type": { "enum": ["solo", "group", "retrospective", "permanent"] },
      "photographerIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
      "description": { "type": "string" }
    }
  }
}
