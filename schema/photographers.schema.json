{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Photographers",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "name": { "type": "string", "minLength": 1 },
      "bio": { "type": "string" },
      "website": { "type": "string", "format": "uri", "pattern": "^https?://" }
    }
  }
}
