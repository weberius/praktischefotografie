{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Photographers",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "name": { "type": "string", "minLength": 1 },
      "bio": { "type": "string" },
      "website": { "type": "string", "format": "uri", "pattern": "^https?://" },
      "occupation": { "type": "string", "minLength": 1, "maxLength": 60 },
      "life": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "integer", "minimum": 1000, "maximum": 2100 },
          "to": { "type": ["integer", "null"], "minimum": 1000, "maximum": 2100 }
        }
      },
      "wikipedia": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "sources"],
        "properties": {
          "summary": { "type": "string", "minLength": 1 },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["lang", "url"],
              "properties": {
                "lang": { "type": "string", "pattern": "^[a-z]{2,3}$" },
                "url": { "type": "string", "format": "uri", "pattern": "^https://" }
              }
            }
          }
        }
      },
      "web": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "sources"],
        "properties": {
          "summary": { "type": "string", "minLength": 1 },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "url"],
              "properties": {
                "title": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "format": "uri", "pattern": "^https?://" }
              }
            }
          }
        }
      },
      "portrait": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "width", "height", "source", "credit", "license"],
        "properties": {
          "file": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.(jpg|png|gif|webp)$" },
          "width": { "type": "integer", "minimum": 1, "maximum": 400 },
          "height": { "type": "integer", "minimum": 1 },
          "source": { "type": "string", "format": "uri", "pattern": "^https://" },
          "credit": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 },
          "licenseUrl": { "type": "string", "format": "uri", "pattern": "^https?://" }
        }
      }
    }
  }
}
