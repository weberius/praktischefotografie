{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Organizers",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "type", "city"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "name": { "type": "string", "minLength": 1 },
      "type": { "enum": ["association", "festival", "network", "foundation"] },
      "city": { "type": "string", "minLength": 1 },
      "shortName": { "type": "string", "minLength": 1 },
      "website": { "type": "string", "format": "uri", "pattern": "^https?://" },
      "description": { "type": "string", "minLength": 1 },
      "social": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "instagram": { "type": "string", "pattern": "^[A-Za-z0-9._]+$" } }
      }
    }
  }
}
