{
  "name": "praktischefotografie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zentrum f\u00fcr Praktische Fotografie \u2013 Datenbasis und Tooling",
  "scripts": {
    "validate:data": "node scripts/validate-data.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "lint": "eslint .",
    "build": "npm --prefix web run build",
    "web:lint": "npm --prefix web run lint",
    "web:test": "npm --prefix web test",
    "lint:all": "npm run lint && npm run web:lint",
    "data:fetch": "node scripts/scrape/fetch-venues.mjs",
    "data:check": "node scripts/scrape/check-proposals.mjs",
    "data:apply": "node scripts/scrape/apply-proposals.mjs",
    "data:report": "node scripts/scrape/report.mjs",
    "news:plan": "node scripts/news/plan-news.mjs",
    "news:check": "node scripts/news/check-news.mjs",
    "news:apply": "node scripts/news/apply-news.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cheerio": "^1.2.0",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  }
}
